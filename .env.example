# Copy to .env and fill in. NEVER commit .env to GitHub.

# Long random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Local development: leave DATABASE_URL commented out to use a SQLite file (local.db).
# AWS RDS:
# DATABASE_URL=mysql://admin:YOUR_PASSWORD@your-db.xxxxxx.ap-southeast-2.rds.amazonaws.com:3306/smart_food_rescue

# Leave S3_BUCKET empty locally (files go to ./uploads). On EC2 set your bucket name.
# No AWS access keys here: on EC2 the IAM role supplies credentials automatically.
S3_BUCKET=
AWS_REGION=ap-southeast-2

# Set to 1 once you serve the site over HTTPS
SESSION_COOKIE_SECURE=0

# Minutes ahead of UTC used for "available until" times (330 = IST)
UTC_OFFSET_MINUTES=330

# ---- Notifications (leave empty locally: emails are printed in the terminal instead) ----
# Amazon SNS topic that sends "new food posted" alerts to all verified NGOs
SNS_TOPIC_ARN=
# Amazon SES verified sender address for request/approval emails, e.g. smartfood.team@gmail.com
SES_SENDER=

# ---- Amazon CloudWatch ----
# 1 = send business metrics (DonationsPosted, MealsRescued, ...) to CloudWatch. Keep 0 locally.
CLOUDWATCH_METRICS=0
# On EC2, the systemd service sets LOG_FILE=/var/log/smartfood/app.log (don't set it here).
