{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## Smart Food Rescue: live operations"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 1,
      "width": 8,
      "height": 5,
      "properties": {
        "title": "Meals rescued (selected time range)",
        "region": "ap-southeast-2",
        "metrics": [
          [
            "SmartFoodRescue",
            "MealsRescued"
          ]
        ],
        "stat": "Sum",
        "period": 300,
        "view": "singleValue",
        "setPeriodToTimeRange": true
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 1,
      "width": 16,
      "height": 5,
      "properties": {
        "title": "Donations, requests and completed pickups (per 5 min)",
        "region": "ap-southeast-2",
        "metrics": [
          [
            "SmartFoodRescue",
            "DonationsPosted"
          ],
          [
            ".",
            "PickupRequests"
          ],
          [
            ".",
            "PickupsCompleted"
          ]
        ],
        "stat": "Sum",
        "period": 300,
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "EC2 web server: CPU and memory (%)",
        "region": "ap-southeast-2",
        "metrics": [
          [
            "AWS/EC2",
            "CPUUtilization",
            "InstanceId",
            "INSTANCE_ID",
            {
              "label": "CPU %"
            }
          ],
          [
            "CWAgent",
            "mem_used_percent",
            "InstanceId",
            "INSTANCE_ID",
            {
              "label": "Memory %"
            }
          ]
        ],
        "stat": "Average",
        "period": 300,
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "RDS database: CPU % and connections",
        "region": "ap-southeast-2",
        "metrics": [
          [
            "AWS/RDS",
            "CPUUtilization",
            "DBInstanceIdentifier",
            "DB_INSTANCE_ID",
            {
              "label": "CPU %"
            }
          ],
          [
            ".",
            "DatabaseConnections",
            ".",
            ".",
            {
              "label": "Connections",
              "yAxis": "right"
            }
          ]
        ],
        "stat": "Average",
        "period": 300,
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Lambda expiry job: runs, errors, listings expired",
        "region": "ap-southeast-2",
        "metrics": [
          [
            "AWS/Lambda",
            "Invocations",
            "FunctionName",
            "smartfood-expire-listings"
          ],
          [
            ".",
            "Errors",
            ".",
            "."
          ],
          [
            "SmartFoodRescue",
            "ListingsExpired",
            "Function",
            "expire-listings"
          ]
        ],
        "stat": "Sum",
        "period": 3600,
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Notifications: SNS alerts published, SES emails sent",
        "region": "ap-southeast-2",
        "metrics": [
          [
            "AWS/SNS",
            "NumberOfMessagesPublished",
            "TopicName",
            "smartfood-food-alerts",
            {
              "label": "SNS food alerts"
            }
          ],
          [
            "AWS/SES",
            "Send",
            {
              "label": "SES emails"
            }
          ]
        ],
        "stat": "Sum",
        "period": 3600,
        "view": "timeSeries"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 18,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "Recent app events (CloudWatch Logs)",
        "region": "ap-southeast-2",
        "view": "table",
        "query": "SOURCE '/smartfood/app' | fields @timestamp, @message | filter @message like /event=/ | sort @timestamp desc | limit 20"
      }
    }
  ]
}