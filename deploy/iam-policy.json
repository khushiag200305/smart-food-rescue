{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3FoodPhotosAndCertificates",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::YOUR-BUCKET-NAME/*"
    },
    {
      "Sid": "SNSFoodAlerts",
      "Effect": "Allow",
      "Action": ["sns:Publish", "sns:Subscribe"],
      "Resource": "arn:aws:sns:ap-southeast-2:YOUR-ACCOUNT-ID:smartfood-food-alerts"
    },
    {
      "Sid": "SESTransactionalEmail",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": "*"
    }
  ]
}
